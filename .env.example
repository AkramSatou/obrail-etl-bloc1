# ============================================================
# ObRail ETL — Variables d'environnement
# ============================================================
# Copier ce fichier en .env et renseigner les valeurs.
# NE JAMAIS committer le fichier .env (listé dans .gitignore).
# ============================================================

# Chemin vers les données CSV
DATA_DIR=./data

# MySQL (version etl_obrail_mysql.py)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=obrail_europe_db

# PostgreSQL (version etl_obrail_postgres.py)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pg_password
PG_DATABASE=obrail_europe_db

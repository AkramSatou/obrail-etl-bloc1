# Cible SGBD : postgresql (défaut) ou mysql
DB_TARGET=postgresql

# PostgreSQL (Docker local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=obrail
DB_PASSWORD=obrail
DB_NAME=obrail

# MySQL/WAMP (pour DB_TARGET=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=obrail_europe_db

# Schéma PostgreSQL (défaut : entrepot)
# ENTREPOT_SCHEMA=entrepot

# URL de test (pour pytest)
# TEST_DATABASE_URL=postgresql+psycopg2://obrail:obrail@localhost:5432/obrail
